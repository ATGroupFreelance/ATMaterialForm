{
  "name": "atmaterialform",
  "private": false,
  "version": "0.2.6",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ATGroupFreelance/ATMaterialForm"
  },
  "author": {
    "name": "ATGroupFreelance"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "license": "ISC",
  "keywords": [
    "react",
    "components",
    "ui",
    "form",
    "atmaterialform"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:test": "vite --mode test --host 127.0.0.1 --port 4173 --strictPort",
    "test:setup": "playwright install chromium",
    "test": "node scripts/check-example-coverage.mjs && node scripts/regression-suite-runner.mjs",
    "test:visual:update": "node scripts/check-example-coverage.mjs && playwright test --config=playwright.config.ts --project=regression --update-snapshots=all",
    "test:example": "node scripts/example-test-runner.mjs regression",
    "test-performance": "node scripts/check-example-coverage.mjs && playwright test --config=playwright.config.ts --project=performance --reporter=./scripts/performance-reporter.mjs",
    "test-performance:example": "node scripts/example-test-runner.mjs performance",
    "test:visual:example": "node scripts/example-test-runner.mjs visual-update"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.9.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-color-sketch": "^2.10.3",
    "@vitejs/plugin-react": "^6.0.0",
    "ag-grid-community": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "date-fns-jalali": "4.4.0-0",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "moment": "^2.30.1",
    "path": "^0.12.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-file-resizer": "^0.4.8",
    "react-toastify": "^11.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "at-shared-types": "^1.2.17"
  }
}
